# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN DATA PIPELINE HGD -> C360 -> BI & API
# Copy file này thành `.env` và điền thông tin thực tế (Không commit file .env)
# ==============================================================================

# 0. MÔI TRƯỜNG CHẠY ỨNG DỤNG ('development' | 'staging' | 'production')
APP_ENV=development

# 1. ORACLE DB NGUỒN (SCHEMA VSS)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=1521
SOURCE_DB_SERVICE=FREEPDB1
SOURCE_DB_USER=vss_source
SOURCE_DB_PASSWORD=change_me_source_pwd
SOURCE_DB_SCHEMA=VSS

# 2. ORACLE DB ĐÍCH (VÙNG MIRROR & C360)
TARGET_DB_HOST=localhost
TARGET_DB_PORT=1521
TARGET_DB_SERVICE=FREEPDB1
TARGET_DB_USER=c360_target
TARGET_DB_PASSWORD=change_me_target_pwd
TARGET_DB_SCHEMA=C360

# 3. KAFKA & DEBEZIUM CONNECT
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_URL=http://localhost:8083

# 4. CẤU HÌNH SPARK FULL LOAD (LOCAL VSS -> MIRROR)
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
JDBC_NUM_PARTITIONS=16
JDBC_FETCH_SIZE=10000

# 4b. ORACLE CLOUD AUTONOMOUS DB (CHỈ DÙNG CHO FULL LOAD BENCHMARK -> PARQUET)
# Có thể để trống FULLLOAD_DB_TNS_ALIAS để tự đọc alias từ tnsnames.ora trong Wallet (ưu tiên *_high)
FULLLOAD_DB_TNS_ALIAS=
FULLLOAD_DB_USER=BHXH_TEST
FULLLOAD_DB_PASSWORD=
# Trỏ tới thư mục Wallet đã giải nén (chứa tnsnames.ora, cwallet.sso, ...)
FULLLOAD_DB_WALLET_LOCATION=D:/OracleCloud/Wallet/Wallet_BHXHTEST
FULLLOAD_DB_TABLE=VSS_HO_GD_NHANKHAU
FULLLOAD_SPARK_MASTER=local[2]
FULLLOAD_DRIVER_MEMORY=2g
FULLLOAD_EXECUTOR_MEMORY=2g
FULLLOAD_PARTITIONS=2
FULLLOAD_FETCH_SIZE=5000
FULLLOAD_PARTITION_MODE=ora_hash
FULLLOAD_PARTITION_COLUMN=MA_CD
FULLLOAD_UPPER_BOUND=10000000

# 5. CẤU HÌNH DATA GENERATOR
SEED_NUM_CITIZENS=50000
SEED_BATCH_SIZE=5000

# 6. CẤU HÌNH REST API & BẢO MẬT
API_HOST=0.0.0.0
API_PORT=8000
API_SAFE_LAG_SECONDS=120
AUDIT_LOG_BATCH_SIZE=100
AUDIT_LOG_FLUSH_INTERVAL_SEC=5.0
